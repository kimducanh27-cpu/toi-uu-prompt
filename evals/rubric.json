{
  "version": "1.0",
  "criteria": [
    {
      "id": "goal",
      "label": "Mục tiêu & vai trò",
      "weight": 15,
      "patterns": ["bạn là", "vai trò|role", "mục tiêu|nhiệm vụ|task|goal"]
    },
    {
      "id": "context",
      "label": "Bối cảnh & người đọc",
      "weight": 15,
      "patterns": ["bối cảnh|context", "người (đọc|dùng)|audience", "dữ kiện|dữ liệu|nguồn|source", "chưa biết|unknown|giả định|assumption"]
    },
    {
      "id": "scope",
      "label": "Phạm vi & non-goals",
      "weight": 10,
      "patterns": ["phạm vi|scope", "không (làm|đụng|refactor|sửa|đổi)|non-goal|không sửa", "chỉ .{0,40}(trong|file|route|màn hình)|only"]
    },
    {
      "id": "constraints",
      "label": "Ràng buộc & an toàn",
      "weight": 15,
      "patterns": ["ràng buộc|constraint", "không bịa|không đoán|no fabrication", "secret|pii|an toàn|safety", "injection|vượt quyền|duyệt|approval"]
    },
    {
      "id": "output",
      "label": "Định dạng đầu ra",
      "weight": 15,
      "patterns": ["định dạng|output format", "json|markdown|schema", "field|trường|bắt buộc|required"]
    },
    {
      "id": "examples",
      "label": "Ví dụ / few-shot",
      "weight": 10,
      "patterns": ["ví dụ|example|few-shot", "đầu vào|input", "đầu ra|output"]
    },
    {
      "id": "acceptance",
      "label": "Nghiệm thu & self-check",
      "weight": 10,
      "patterns": ["nghiệm thu|acceptance|tiêu chí|criteria", "tự kiểm|self-check|kiểm lại", "repro|expected|actual|pass/fail"]
    },
    {
      "id": "model_token",
      "label": "Model fit & token",
      "weight": 5,
      "patterns": ["token|độ dài|budget|ngắn", "model|gemini|claude|gpt|antigravity"]
    },
    {
      "id": "maintenance",
      "label": "Bảo trì & version",
      "weight": 5,
      "patterns": ["version|phiên bản|changelog", "owner|duyệt|review"]
    }
  ],
  "caps": {
    "missing_output": 70,
    "unsafe": 40,
    "missing_acceptance": 80
  },
  "unsafe_patterns": [
    "ignore (all )?previous",
    "reveal (the )?system",
    "drop database",
    "rm -rf",
    "hãy bịa|phải bịa|được phép bịa",
    "deploy.*production.*without"
  ]
}
